PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

MONGO_URI=mongodb+srv://your_mongodb_uri.mongodb.net/

JWT_SECRET=enter_anything_strong
JWT_REFRESH_SECRET=enter_anything_strong420

# Oauth
# Configure this from site: http://console.cloud.google.com/apis/ 
# Visit Credentials for this and paste client id here
GOOGLE_CLIENT_ID=blah_blah.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_secret_from_credentials

# AI assistant
# Configure this from site: https://aistudio.google.com/api-keys/ 
# Visit create api keys for this and paste api key here
GOOGLE_API_KEY=your_gemini_api_key
# your model (we are using latest model available here you change it as well)
GEMINI_MODEL=gemini-3.8-flash

UPLOAD_DIR=./uploads
